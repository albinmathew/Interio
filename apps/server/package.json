{
  "name": "@interio/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "tsx --env-file-if-exists=../../.env src/index.ts",
    "analyze": "tsx --env-file-if-exists=../../.env src/cli.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@hono/node-server": "^2.1.6",
    "@interio/core": "workspace:*",
    "hono": "^4.13.17",
    "zod": "^4.6.7"
  }
}
