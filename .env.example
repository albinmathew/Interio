# AI assist is optional. Without it the import reads the PDF's line work only and nothing leaves your computer.
# Choose ONE of the two ways to switch it on.

# 1) Anthropic API key (works anywhere, billed to the key).
ANTHROPIC_API_KEY=

# 2) The Claude Code login on this computer (local use, no key). Needs Claude Code installed and signed in.
#    Each import is one small call that counts against your Claude plan's usage.
# INTERIO_AI_PROVIDER=claude-code
# INTERIO_CLAUDE_COMMAND=        # path of the `claude` executable, only if it is not found automatically

# Model. Default: claude-fable-5-2 with an API key, claude-opus-5-5 through Claude Code.
# ANTHROPIC_MODEL=

# Ports (override per git worktree to run several checkouts side by side)
INTERIO_WEB_PORT=5173
INTERIO_API_PORT=8787

# AI assist tuning (optional)
# INTERIO_AI_FALLBACKS=off   # API key only: disable the refusal fallback
# INTERIO_AI_EFFORT=         # low | medium | high | xhigh | max (model default when unset)
