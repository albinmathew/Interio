{
  "name": "interio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "pnpm --parallel --filter @interio/web --filter @interio/server dev",
    "dev:web": "pnpm --filter @interio/web dev",
    "dev:server": "pnpm --filter @interio/server dev",
    "build": "pnpm --filter @interio/web build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint --deny-warnings",
    "e2e": "playwright test -c tests/e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "jsdom": "^31.0.0",
    "oxlint": "^1.92.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
